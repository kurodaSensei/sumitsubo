{
  "name": "sumitsubo",
  "version": "0.6.0",
  "description": "Installer for Sumitsubo, a Claude Code framework for web design and development: direction first, then the work.",
  "type": "module",
  "bin": {
    "sumitsubo": "bin/sumitsubo.mjs",
    "sumi": "bin/sumitsubo.mjs"
  },
  "files": [
